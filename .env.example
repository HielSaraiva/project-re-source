# Aplicação: endereço usado nos links dos e-mails
APP_BASE_URL=http://localhost:8080

# PostgreSQL (também utilizado pelo Docker Compose)
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret
DB_POOL_SIZE=20

# RabbitMQ (também utilizado pelo Docker Compose)
RABBITMQ_USER=myuser
RABBITMQ_PASSWORD=secret

# Login Google (OAuth / OpenID Connect)
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cadastro institucional: diretório privado e persistente em produção
INSTITUTION_DOCUMENT_DIRECTORY=var/private/institution-documents
BRASIL_API_URL=https://brasilapi.com.br/api

# E-mails: habilitação e remetente compartilhados
MAIL_ENABLED=false
MAIL_FROM=nao-responda@example.com

# SMTP: porta 587 com STARTTLS; porta 465 com SSL e STARTTLS desativado
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=nao-responda@example.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false

# Notificações: false suspende apenas os e-mails de atualizações
NOTIFICATION_EMAIL_ENABLED=true

# Logs: LOG_FORMAT vazio usa texto; ecs habilita JSON
RESOURCE_LOG_LEVEL=INFO
LOG_FORMAT=
SLOW_REQUEST_MS=1000
