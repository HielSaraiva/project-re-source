# PostgreSQL
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=20

# RabbitMQ
RABBITMQ_USER=myuser
RABBITMQ_PASSWORD=change-me

# Login Google
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cadastro institucional: diretório privado e persistente em produção
INSTITUTION_DOCUMENT_DIRECTORY=var/private/institution-documents
BRASIL_API_URL=https://brasilapi.com.br/api

# E-mails
MAIL_ENABLED=false
MAIL_FROM=nao-responda@example.com

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=nao-responda@example.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
NOTIFICATION_EMAIL_ENABLED=true

# Aplicação
APP_BASE_URL=http://localhost:8080

# Privacidade: endereço para solicitações
PRIVACY_CONTACT_EMAIL=resource.company.rc@gmail.com

# Logs
RESOURCE_LOG_LEVEL=INFO
LOG_FORMAT=
SLOW_REQUEST_MS=1000
